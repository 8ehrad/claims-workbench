# Use a dedicated demo database. Seeding replaces the app's tables.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
OPENROUTER_API_KEY=replace-with-openrouter-key
CLAIMS_API_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Optional: choose one available OpenRouter model before seeding.
# With MODEL_NAME set, the judge is disabled and the model is used for all agents.
# MODEL_NAME=provider/model

# Local service defaults; Docker Compose supplies container addresses separately.
CLAIMS_API=http://127.0.0.1:8000
CLAIMS_AGENT=http://127.0.0.1:8080
CLAIMS_COPILOT=http://127.0.0.1:8081
CLAIMS_CONTEXT=http://127.0.0.1:8006/mcp

# Optional cloud integrations; leave unset for the direct route.
# CLAIMS_GATEWAY_URL=
# CLAIMS_MEMORY_ID=
# CLAIMS_COPILOT_MEMORY_ID=
# CLAIMS_AGENT_RUNTIME=
# CLAIMS_COPILOT_RUNTIME=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=
# HANDLER_PASSWORD=

# Optional: map existing Supabase accounts to demo handler ids.
# Apply with npm run configure:handlers; npm run seed also respects this mapping.
# CLAIMS_HANDLER_EMAILS='{"HND-01":"senior@example.com"}'
